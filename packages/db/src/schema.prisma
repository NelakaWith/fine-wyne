model User {
  id String @id @default(uuid())
  name String
  email String @unique
  messages Message[]
}

model Room {
  id String @id @default(uuid())
  name String
  messages Message[]
}

model Message {
  id String @id @default(uuid())
  content String
  createdAt DateTime @default(now())
  sender   User @relation(fields: [senderId], references: [id])
  senderId String
  room     Room @relation(fields: [roomId], references: [id])
  roomId   String
}
